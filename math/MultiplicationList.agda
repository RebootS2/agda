module MultiplicationList where

-- ---------------------------------------------------------------------------
-- 0. 証明に使うライブラリ読み込みと定義
-- ---------------------------------------------------------------------------
open import Relation.Binary.PropositionalEquality
open ≡-Reasoning

-- ---------------------------------------------------------------------------
-- A. 数の演算 
-- ---------------------------------------------------------------------------
-- 1. 自然数の定義
data ℕ : Set where
  zero : ℕ
  suc  : ℕ → ℕ

-- 2. 足し算の定義（優先順位6 / 左引数）
infixl 6 _+_
_+_ : ℕ → ℕ → ℕ
zero  + y = y
suc x + y = suc (x + y)

-- 3. かけ算の定義（優先順位7 / 左引数）　一つ目の定義
-- infixl 7 _*_
_*_ : ℕ → ℕ → ℕ
zero  * y = zero
suc x * y = y + (x * y)

-- ---------------------------------------------------------------------------
-- B. 証明準備
-- ---------------------------------------------------------------------------
-- ==========================================
-- 足し算に関する基本的な補題
-- ==========================================

+-assoc : (x y z : ℕ) → x + (y + z) ≡ (x + y) + z
+-assoc zero y z = refl
+-assoc (suc x) y z = cong suc (+-assoc x y z)

+-zeroʳ : (x : ℕ) → x + zero ≡ x
+-zeroʳ zero = refl
+-zeroʳ (suc x) = cong suc (+-zeroʳ x)

+-sucʳ : (x y : ℕ) → x + suc y ≡ suc (x + y)
+-sucʳ zero y = refl
+-sucʳ (suc x) y = cong suc (+-sucʳ x y)

+-comm : (x y : ℕ) → x + y ≡ y + x
+-comm zero y = sym (+-zeroʳ y)
+-comm (suc x) y = begin
  suc (x + y)
    ≡⟨ cong suc (+-comm x y) ⟩
  suc (y + x)
    ≡⟨ sym (+-sucʳ y x) ⟩
  y + suc x
  ∎
-- ---------------------------------------------------------------------------
-- C. 一つ分を、a, bどちらにでも定義できることを示す証明
-- ---------------------------------------------------------------------------
-- 左側の引数（いくつ分）が増えたときの性質
-- かけ算は左側の引数で再帰するように定義されているため、
-- 足し算の交換法則(+-comm)を1回使うだけで導かれる。
thm1 : (a b : ℕ) → suc a * b ≡ a * b + b
thm1 a b = +-comm b (a * b)

-- 右側の引数（一つ分）が増えたときの性質
-- 左引数で定義されたかけ算に対して、右側の引数で展開しても
-- 同じ形になること（右側での再帰的性質）を帰納法で証明する。
thm2 : (a b : ℕ) → a * suc b ≡ a * b + a
thm2 zero b = refl
thm2 (suc a) b = begin
  suc b + a * suc b
    ≡⟨ cong (suc b +_) (thm2 a b) ⟩
  suc (b + (a * b + a))
    ≡⟨ cong suc (+-assoc b (a * b) a) ⟩
  suc ((b + a * b) + a)
    ≡⟨ sym (+-sucʳ (b + a * b) a) ⟩
  (b + a * b) + suc a
  ∎

-- ---------------------------------------------------------------------------
-- D. 定義の任意性：他方の「かけ算」の定義とその等価性
-- ---------------------------------------------------------------------------
-- 等価性の証明準備
*-zeroʳ : (x : ℕ) → x * zero ≡ zero
*-zeroʳ zero = refl
*-zeroʳ (suc x) = *-zeroʳ x

-- 他方のかけ算の定義（優先順位7 / 右引数）　二つ目の定義
-- 今回は「右側の引数（一つ分）」で再帰するように定義する。
infixl 7 _*'_
_*'_ : ℕ → ℕ → ℕ
x *' zero  = zero
x *' suc y = x + (x *' y)

-- この「右再帰のかけ算(*')」において、左側が増えたときの性質（thm2の双対）
-- 帰納法で証明する。
thm1' : (a b : ℕ) → suc a *' b ≡ a *' b + b
thm1' a zero = refl
thm1' a (suc b) = begin
  suc a *' suc b
    -- *' の定義より、suc a + (suc a *' b) と展開される
    ≡⟨ cong (suc a +_) (thm1' a b) ⟩
  suc a + (a *' b + b)
    -- 足し算の定義より suc (a + (a *' b + b)) なので、結合法則でカッコを移動
    ≡⟨ cong suc (+-assoc a (a *' b) b) ⟩
  suc ((a + a *' b) + b)
    -- + の右側の suc を外に出す
    ≡⟨ sym (+-sucʳ (a + a *' b) b) ⟩
  (a + a *' b) + suc b
    -- a + a *' b は a *' suc b の定義そのもの。
  ∎

-- 結論：左再帰の(*)と右再帰の(*')は、全く同じ演算であって、
-- 実装が異なるだけ。
*-equiv : (a b : ℕ) → a * b ≡ a *' b
*-equiv a zero = *-zeroʳ a
*-equiv a (suc b) = begin
  a * suc b
    -- (*) における右側の展開（Cで証明した thm2）
    ≡⟨ thm2 a b ⟩
  a * b + a
    -- 帰納法の仮定から、* を *' に置き換える
    ≡⟨ cong (_+ a) (*-equiv a b) ⟩
  a *' b + a
    -- 足し算の順序を交換
    ≡⟨ +-comm (a *' b) a ⟩
  a + a *' b
    -- *' の定義そのものである。
    ≡⟨ refl ⟩
  a *' suc b
  ∎

-- ==========================================
-- おまけ：かけ算の交換則の証明
-- ==========================================
-- 左引数の交換則の証明
*-comm : (a b : ℕ) → a * b ≡ b * a
*-comm zero b = sym (*-zeroʳ b)
*-comm (suc a) b = begin
  suc a * b
    ≡⟨ thm1 a b ⟩
  a * b + b
    ≡⟨ cong (_+ b) (*-comm a b) ⟩
  b * a + b
    ≡⟨ sym (thm2 b a) ⟩
  b * suc a
  ∎

-- 右引数の交換則の証明
*-zero'ʳ : (x : ℕ) → zero *' x ≡ zero
*-zero'ʳ zero = refl
*-zero'ʳ (suc x) = *-zero'ʳ x

*-comm' : (a b : ℕ) → a *' b ≡ b *' a
*-comm' zero b = *-zero'ʳ b
*-comm' (suc a) b = begin
  suc a *' b
    ≡⟨ thm1' a b ⟩
  a *' b + b
    ≡⟨ cong (_+ b) (*-comm' a b) ⟩
  b *' a + b
    ≡⟨ +-comm (b *' a) b ⟩
  b + b *' a
  ∎

-- ---------------------------------------------------------------------------
-- E. リストによる数値の定義
-- ---------------------------------------------------------------------------
-- 1. O の定義 要素が O だけの型を作る
data Unit : Set where
  O : Unit

-- 2. O を持つリストの定義
-- 空のリスト [] と、O を先頭に追加する _∷_ (cons) で定義
data List : Set where
  []  : List
  _∷_ : Unit → List → List

-- 3. 結合（足し算に相当）
-- 1つ目のリストが空になるまで O を取り出し、2つ目のリストに接続
_++_ : List → List → List
[] ++ ys = ys
(O ∷ xs) ++ ys = O ∷ (xs ++ ys)

-- 4. 繰り返し結合（掛け算に相当）
-- 「xs * ys」は、ys の要素(O)の数だけ、xs を足し合わせる演算です。
_**_ : List → List → List
xs ** [] = []                  -- 0回掛ける場合は空リスト
xs ** (O ∷ ys) = xs ++ (xs ** ys)      -- 1回分(xs)を足し、残りの回数分(xs ** ys)と結合する-- 1. O の定義 (要素が O だけの型を作ります)


-- ==========================================
-- F. O を要素にするListと、自然数を相互に変換する関数を定義する
-- ==========================================

-- 1. List から ℕ への変換（要素Oの数を数える）
listToNat : List → ℕ
listToNat []       = zero
listToNat (O ∷ xs) = suc (listToNat xs)

-- 2. ℕ から List への変換（数だけOを繋げる）
natToList : ℕ → List
natToList zero    = []
natToList (suc n) = O ∷ natToList n

-- ==========================================
-- 3. 自然数 ℕ と List が1対1対応で対応がとれていることを示すため
-- 行って帰ってきたら元に戻ることを証明する
-- ==========================================

-- 証明A: ℕ → List → ℕ と変換すると、元の自然数に戻る
-- listToNat (natToList n) ≡ n
iso-nat : ∀ (n : ℕ) → listToNat (natToList n) ≡ n
iso-nat zero    = refl                         -- 0 の場合は自明
iso-nat (suc n) rewrite iso-nat n = refl       -- suc n の場合は、n についての仮定を使って書き換える

-- 証明B: List → ℕ → List と変換すると、元のリストに戻る
-- natToList (listToNat xs) ≡ xs
iso-list : ∀ (xs : List) → natToList (listToNat xs) ≡ xs
iso-list []       = refl                       -- 空リストの場合は自明
iso-list (O ∷ xs) rewrite iso-list xs = refl   -- O ∷ xs の場合は、xs についての仮定を使って書き換える

-- ===================================================================
-- 結論：一つの要素(本コードでは"O")を持つListは、自然数と互いに変換できることを証明した。
-- ===================================================================
-- つまり本Listと自然数は同型と言えて、自然数の演算は、本Listで構成できる。
-- 一方、Listの要素に複数の要素を持つ場合（空リストは対象外）には、
-- 自然数と対応が取れず、自然数の演算とListの演算を対応させることができない。
-- 言い換えると、このListで演算を作ったとしても、自然数の演算と対応しているという主張は不可。

-- 圏論の定理
-- 「要素を1つしか持たない型（Terminal Object）のリスト List(1) は、自然数 と同型」
-- を示したに過ぎない。

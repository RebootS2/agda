module Multiplication where

-- ---------------------------------------------------------------------------
-- 0. 証明に使うライブラリ読み込みと定義
-- ---------------------------------------------------------------------------
open import Relation.Binary.PropositionalEquality
open ≡-Reasoning

-- ---------------------------------------------------------------------------
-- A. 数の演算 
-- ---------------------------------------------------------------------------
-- 1. 自然数の定義
data ℕ : Set where
  zero : ℕ
  suc  : ℕ → ℕ

-- 2. 足し算の定義（優先順位6 / 左引数）
infixl 6 _+_
_+_ : ℕ → ℕ → ℕ
zero  + y = y
suc x + y = suc (x + y)

-- 3. かけ算の定義（優先順位7 / 左引数）　一つ目の定義
infixl 7 _*_
_*_ : ℕ → ℕ → ℕ
zero  * y = zero
suc x * y = y + (x * y)

-- ---------------------------------------------------------------------------
-- B. 証明準備
-- ---------------------------------------------------------------------------
-- ==========================================
-- 足し算に関する基本的な補題
-- ==========================================

+-assoc : (x y z : ℕ) → x + (y + z) ≡ (x + y) + z
+-assoc zero y z = refl
+-assoc (suc x) y z = cong suc (+-assoc x y z)

+-zeroʳ : (x : ℕ) → x + zero ≡ x
+-zeroʳ zero = refl
+-zeroʳ (suc x) = cong suc (+-zeroʳ x)

+-sucʳ : (x y : ℕ) → x + suc y ≡ suc (x + y)
+-sucʳ zero y = refl
+-sucʳ (suc x) y = cong suc (+-sucʳ x y)

+-comm : (x y : ℕ) → x + y ≡ y + x
+-comm zero y = sym (+-zeroʳ y)
+-comm (suc x) y = begin
  suc (x + y)
    ≡⟨ cong suc (+-comm x y) ⟩
  suc (y + x)
    ≡⟨ sym (+-sucʳ y x) ⟩
  y + suc x
  ∎
-- ---------------------------------------------------------------------------
-- C. 一つ分を、a, bどちらにでも定義できることを示す証明
-- ---------------------------------------------------------------------------
-- 左側の引数（いくつ分）が増えたときの性質
-- かけ算は左側の引数で再帰するように定義されているため、
-- 足し算の交換法則(+-comm)を1回使うだけで導かれる。
thm1 : (a b : ℕ) → suc a * b ≡ a * b + b
thm1 a b = +-comm b (a * b)

-- 右側の引数（一つ分）が増えたときの性質
-- 左引数で定義されたかけ算に対して、右側の引数で展開しても
-- 同じ形になること（右側での再帰的性質）を帰納法で証明する。
thm2 : (a b : ℕ) → a * suc b ≡ a * b + a
thm2 zero b = refl
thm2 (suc a) b = begin
  suc b + a * suc b
    ≡⟨ cong (suc b +_) (thm2 a b) ⟩
  suc (b + (a * b + a))
    ≡⟨ cong suc (+-assoc b (a * b) a) ⟩
  suc ((b + a * b) + a)
    ≡⟨ sym (+-sucʳ (b + a * b) a) ⟩
  (b + a * b) + suc a
  ∎

-- ---------------------------------------------------------------------------
-- D. 定義の任意性：他方の「かけ算」の定義とその等価性
-- ---------------------------------------------------------------------------
-- 等価性の証明準備
*-zeroʳ : (x : ℕ) → x * zero ≡ zero
*-zeroʳ zero = refl
*-zeroʳ (suc x) = *-zeroʳ x

-- 他方のかけ算の定義（優先順位7 / 右引数）　二つ目の定義
-- 今回は「右側の引数（一つ分）」で再帰するように定義する。
infixl 7 _*'_
_*'_ : ℕ → ℕ → ℕ
x *' zero  = zero
x *' suc y = x + (x *' y)

-- この「右再帰のかけ算(*')」において、左側が増えたときの性質（thm2の双対）
-- 帰納法で証明する。
thm1' : (a b : ℕ) → suc a *' b ≡ a *' b + b
thm1' a zero = refl
thm1' a (suc b) = begin
  suc a *' suc b
    -- *' の定義より、suc a + (suc a *' b) と展開される
    ≡⟨ cong (suc a +_) (thm1' a b) ⟩
  suc a + (a *' b + b)
    -- 足し算の定義より suc (a + (a *' b + b)) なので、結合法則でカッコを移動
    ≡⟨ cong suc (+-assoc a (a *' b) b) ⟩
  suc ((a + a *' b) + b)
    -- + の右側の suc を外に出す
    ≡⟨ sym (+-sucʳ (a + a *' b) b) ⟩
  (a + a *' b) + suc b
    -- a + a *' b は a *' suc b の定義そのもの。
  ∎

-- 結論：左再帰の(*)と右再帰の(*')は、全く同じ演算であって、
-- 実装が異なるだけ。
*-equiv : (a b : ℕ) → a * b ≡ a *' b
*-equiv a zero = *-zeroʳ a
*-equiv a (suc b) = begin
  a * suc b
    -- (*) における右側の展開（Cで証明した thm2）
    ≡⟨ thm2 a b ⟩
  a * b + a
    -- 帰納法の仮定から、* を *' に置き換える
    ≡⟨ cong (_+ a) (*-equiv a b) ⟩
  a *' b + a
    -- 足し算の順序を交換
    ≡⟨ +-comm (a *' b) a ⟩
  a + a *' b
    -- *' の定義そのものである。
    ≡⟨ refl ⟩
  a *' suc b
  ∎

-- ==========================================
-- おまけ：かけ算の交換則の証明
-- ==========================================
-- 左引数の交換則の証明
*-comm : (a b : ℕ) → a * b ≡ b * a
*-comm zero b = sym (*-zeroʳ b)
*-comm (suc a) b = begin
  suc a * b
    ≡⟨ thm1 a b ⟩
  a * b + b
    ≡⟨ cong (_+ b) (*-comm a b) ⟩
  b * a + b
    ≡⟨ sym (thm2 b a) ⟩
  b * suc a
  ∎

-- 右引数の交換則の証明
*-zero'ʳ : (x : ℕ) → zero *' x ≡ zero
*-zero'ʳ zero = refl
*-zero'ʳ (suc x) = *-zero'ʳ x

*-comm' : (a b : ℕ) → a *' b ≡ b *' a
*-comm' zero b = *-zero'ʳ b
*-comm' (suc a) b = begin
  suc a *' b
    ≡⟨ thm1' a b ⟩
  a *' b + b
    ≡⟨ cong (_+ b) (*-comm' a b) ⟩
  b *' a + b
    ≡⟨ +-comm (b *' a) b ⟩
  b + b *' a
  ∎

-- ==========================================
-- 結論：かけ算の定義の任意性と等価性について
-- ==========================================
-- 以上により、自然数のかけ算は「左側の引数（いくつ分）」で再帰する定義（*）を取っても、
-- 「右側の引数（一つ分）」で再帰する定義（*'）を取っても、
-- 全く同じ結果を導く（a * b ≡ a *' b）ことが証明された。
-- 
-- また、どちらの定義を出発点とした場合でも、最終的には交換法則が成立し、
-- 数学的な構造として完全に等価であることが示された。
-- 
-- この証明により、数学的な構造そのものにおいて「自然数のかけ算には無条件に
-- 唯一の順序（一つ分×いくつ分）が存在する」という主張は完全に否定される。
-- 順序の非対称性は、自然数の性質ではなく、あくまで「計算プロセス（再帰）」
-- を記述する際の人為的なモデリングの都合に過ぎない。
-- 
-- ただし、教育やシステムの実装において「複数ある定義候補（モデリング）のうち、
-- 便宜上どちらか一つだけを標準として採用する」という運用自体は否定されない。
